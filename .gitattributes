# ==========================================
# GIT ATTRIBUTES FOR FORK SYNC
# ==========================================
# Files listed here keep the FORK's version when syncing from upstream.
# `merge=ours` alone only decides conflicts, so sync-template.sh also
# restores every path below after merging (it reads this list).
# Everything not listed (generator, templates, js/, css/style.css, docs)
# takes the upstream version.

# Your content and colors
data/** merge=ours
assets/** merge=ours
resume/** merge=ours
css/palette.css merge=ours

# Search-engine settings and generated pages (rebuilt by `node generate-pages.js`)
robots.txt merge=ours
sitemap.xml merge=ours
index.html merge=ours
about.html merge=ours
summary.html merge=ours
cv.html merge=ours
projects.html merge=ours
links.html merge=ours
